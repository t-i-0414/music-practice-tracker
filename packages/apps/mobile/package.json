{
  "name": "@music-practice-tracker/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build-storybook": "storybook build",
    "doctor": "npx expo-doctor",
    "gen:api-types": "bun scripts/gen.api-types.ts",
    "lint:es:check": "eslint",
    "lint:es:fix": "eslint --fix",
    "maestro:install": "curl -Ls 'https://get.maestro.mobile.dev' | bash",
    "reset-project": "node ./scripts/reset-project.js",
    "start:dev": "expo start",
    "start:dev:android": "expo start --android --port 8082",
    "start:dev:ios": "expo start --ios --port 8081",
    "start:dev:web": "expo start --web --port 8083",
    "storybook": "cross-env APP_ENV='storybook' expo start --port 6007",
    "storybook:android": "bun run storybook --android",
    "storybook:generate": "sb-rn-get-stories",
    "storybook:ios": "bun run storybook --ios",
    "storybook:web": "storybook dev -p 6008",
    "test": "run-s test:unit test:e2e",
    "test:e2e": "make test-e2e",
    "test:e2e:ui": "make test-e2e-ui",
    "test:unit": "jest --config tests/unit/jest.config.ts",
    "test:unit:cov": "bun run test:unit --coverage",
    "test:unit:debug": "node --inspect-brk ./node_modules/.bin/jest --runInBand",
    "test:unit:watch": "bun run test:unit --watch",
    "type:check": "run-p --print-label type:check:base type:check:storybook",
    "type:check:base": "tsc --noEmit",
    "type:check:storybook": "tsc --noEmit -p tsconfig.storybook.json"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.5",
    "@react-navigation/native": "^7.1.8",
    "@storybook/addon-ondevice-actions": "^10.0.1",
    "@storybook/addon-ondevice-backgrounds": "^10.0.1",
    "@storybook/addon-ondevice-controls": "^10.0.1",
    "@storybook/addon-ondevice-notes": "^10.0.1",
    "expo": "~54.0.27",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.11",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.10",
    "expo-router": "~6.0.17",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.15",
    "expo-web-browser": "~15.0.10",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "7.28.3",
    "@babel/plugin-transform-class-static-block": "^7.28.3",
    "@babel/runtime": "^7.28.4",
    "@expo/metro-runtime": "~6.1.2",
    "@storybook/react": "^10.0.3",
    "@storybook/react-native": "^10.0.1",
    "@storybook/react-native-web-vite": "^10.0.3",
    "@testing-library/jest-native": "5.4.3",
    "@testing-library/react-native": "13.2.0",
    "@types/babel__core": "7.20.5",
    "@types/react-native-web": "0.19.1",
    "babel-preset-expo": "~54.0.0",
    "eslint-config-expo": "~10.0.0"
  }
}
