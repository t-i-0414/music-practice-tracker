{
  "cli": {
    "version": ">= 16.17.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_ENV": "development"
      }
    },
    "staging": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "staging"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production"
      }
    },
    "storybook": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "storybook",
        "EXPO_PUBLIC_STORYBOOK_ENABLED": "true"
      }
    },
    "storybook-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_ENV": "storybook",
        "EXPO_PUBLIC_STORYBOOK_ENABLED": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
