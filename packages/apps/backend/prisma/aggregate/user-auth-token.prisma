model UserAuthToken {
  id           Int       @id @default(autoincrement())
  publicId     String    @unique @default(uuid()) @map("public_id") @db.Uuid
  token        String    @unique
  type         TokenType @map("type")
  userPublicId String    @map("user_public_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         User      @relation(fields: [userPublicId], references: [publicId], onDelete: Cascade)

  @@index([userPublicId])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("user_auth_tokens")
}

enum TokenType {
  REFRESH
  PASSWORD_RESET
  EMAIL_VERIFICATION

  @@map("token_type")
}
