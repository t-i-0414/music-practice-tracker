{
  "name": "@music-practice-tracker/backend",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "scripts": {
    "build": "nest build",
    "lint:es:check": "eslint",
    "lint:es:fix": "eslint --fix",
    "open:swagger-ui": "run-p --print-label -c open:swagger-ui:*",
    "open:swagger-ui:admin": "ts-node scripts/open-swagger-ui.ts admin",
    "open:swagger-ui:app": "ts-node scripts/open-swagger-ui.ts app",
    "prisma:client:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:migrate:apply": "run-p --print-label prisma:migrate:apply:*",
    "prisma:migrate:apply:default": "dotenv -e .env -- prisma migrate deploy",
    "prisma:migrate:apply:test": "dotenv -e .env.test -- prisma migrate deploy",
    "prisma:migrate:dev": "run-p --print-label prisma:migrate:dev:*",
    "prisma:migrate:dev:default": "dotenv -e .env -- prisma migrate dev",
    "prisma:migrate:dev:test": "dotenv -e .env.test -- prisma migrate dev",
    "prisma:migrate:generate": "dotenv -e .env -- prisma migrate dev --create-only",
    "prisma:migrate:reset": "run-p --print-label prisma:migrate:reset:*",
    "prisma:migrate:reset:dev": "dotenv -e .env -- prisma migrate reset --force",
    "prisma:migrate:reset:test": "dotenv -e .env.test -- prisma migrate reset --force",
    "prisma:migrate:status": "run-p --print-label prisma:migrate:status:*",
    "prisma:migrate:status:default": "dotenv -e .env -- prisma migrate status",
    "prisma:migrate:status:test": "dotenv -e .env.test -- prisma migrate status",
    "prisma:schema:diff:check": "run-p --print-label prisma:schema:diff:check:*",
    "prisma:schema:diff:check:default": "dotenv -e .env -- sh -c 'out=$(prisma migrate diff --from-schema src/repository --to-config-datasource \"$DATABASE_URL\"); printf \"%s\n\" \"$out\"; ! echo \"$out\" | grep -q \"\\[\\*\\] Changed\"'",
    "prisma:schema:diff:check:test": "dotenv -e .env.test -- sh -c 'out=$(prisma migrate diff --from-schema src/repository --to-config-datasource \"$DATABASE_URL\"); printf \"%s\n\" \"$out\"; ! echo \"$out\" | grep -q \"\\[\\*\\] Changed\"'",
    "prisma:schema:diff:generate": "run-p --print-label prisma:schema:diff:generate:*",
    "prisma:schema:diff:generate:default": "dotenv -e .env -- sh -c 'prisma migrate diff  --from-schema src/repository --to-config-datasource \"$DATABASE_URL\" --script > src/repository/diff.sql'",
    "prisma:schema:diff:generate:test": "dotenv -e .env.test -- sh -c 'prisma migrate diff  --from-schema src/repository --to-config-datasource \"$DATABASE_URL\" --script > src/repository/diff-test.sql'",
    "prisma:schema:print:dev": "prisma db pull --print",
    "prisma:schema:print:test": "dotenv -e .env.test -- prisma db pull --print",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate",
    "seed:all": "bun run seed:firebase-auth && bun run src/repository/seeds/index.seed.ts",
    "seed:firebase-auth": "bun run src/firebase-auth/firebase-auth.seed.ts",
    "seed:user": "bun run src/repository/seeds/user.seed.ts",
    "start:debug": "run-p --print-label start:debug:* start:test:firebase-auth-emulators",
    "start:debug:admin-api": "nest start admin-api --debug --watch",
    "start:debug:app-api": "nest start app-api --debug --watch",
    "start:debug:firebase-auth-emulators": "make start-firebase-dev-emulators",
    "start:dev": "run-p --print-label start:dev:* start:test:firebase-auth-emulators",
    "start:dev:admin-api": "nest start admin-api --watch",
    "start:dev:app-api": "nest start app-api --watch",
    "start:dev:firebase-auth-emulators": "make start-firebase-dev-emulators",
    "start:prod": "run-p --print-label start:prod:*",
    "start:prod:admin-api": "node dist/apis/admin/main",
    "start:prod:app-api": "node dist/apis/app/main",
    "start:test": "run-p --print-label start:test:*",
    "start:test:admin-api": "dotenv -e .env.test -- nest start admin-api",
    "start:test:app-api": "dotenv -e .env.test -- nest start app-api",
    "start:test:firebase-auth-emulators": "make start-firebase-test-emulators",
    "test": "jest --config ./tests/jest.config.ts",
    "test:cov": "bun run test --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config ./tests/jest.config.ts --runInBand",
    "test:watch": "bun run test --watch",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.19",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.19",
    "@nestjs/swagger": "11.2.7",
    "@nestjs/terminus": "^11.0.0",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "7.7.0",
    "bcrypt": "6.0.0",
    "dd-trace": "^5.85.0",
    "nestjs-cls": "^6.2.0",
    "nestjs-pino": "^4.5.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@golevelup/ts-jest": "3.0.0",
    "@music-practice-tracker/eslint-plugins": "workspace:*",
    "@nestjs/cli": "11.0.19",
    "@nestjs/schematics": "11.0.10",
    "@nestjs/testing": "11.1.19",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "firebase-admin": "13.8.0",
    "open": "11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "7.7.0",
    "supertest": "7.2.2"
  }
}
