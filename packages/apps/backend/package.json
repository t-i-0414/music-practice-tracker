{
  "name": "@music-practice-tracker/backend",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "scripts": {
    "build": "nest build",
    "lint:es:check": "eslint",
    "lint:es:fix": "eslint --fix",
    "open:swagger-ui": "run-p -c open:swagger-ui:*",
    "open:swagger-ui:admin": "ts-node scripts/open-swagger-ui.ts admin",
    "open:swagger-ui:app": "ts-node scripts/open-swagger-ui.ts app",
    "prisma:client:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:migrate:apply": "run-p prisma:migrate:apply:*",
    "prisma:migrate:apply:default": "dotenv -e .env -- prisma migrate deploy",
    "prisma:migrate:apply:test": "dotenv -e .env.test -- prisma migrate deploy",
    "prisma:migrate:dev": "run-p prisma:migrate:dev:*",
    "prisma:migrate:dev:default": "dotenv -e .env -- prisma migrate dev",
    "prisma:migrate:dev:test": "dotenv -e .env.test -- prisma migrate dev",
    "prisma:migrate:generate": "dotenv -e .env -- prisma migrate dev --create-only",
    "prisma:migrate:reset": "run-p prisma:migrate:reset:*",
    "prisma:migrate:reset:dev": "dotenv -e .env -- prisma migrate reset --force",
    "prisma:migrate:reset:test": "dotenv -e .env.test -- prisma migrate reset --force",
    "prisma:migrate:status": "run-p prisma:migrate:status:*",
    "prisma:migrate:status:default": "dotenv -e .env -- prisma migrate status",
    "prisma:migrate:status:test": "dotenv -e .env.test -- prisma migrate status",
    "prisma:schema:diff:check": "run-p prisma:schema:diff:check:*",
    "prisma:schema:diff:check:default": "dotenv -e .env -- sh -c 'prisma migrate diff --from-url \"$DATABASE_URL\" --to-schema-datamodel prisma --exit-code'",
    "prisma:schema:diff:check:test": "dotenv -e .env.test -- sh -c 'prisma migrate diff --from-url \"$DATABASE_URL\" --to-schema-datamodel prisma --exit-code'",
    "prisma:schema:diff:generate": "run-p prisma:schema:diff:generate:*",
    "prisma:schema:diff:generate:default": "dotenv -e .env -- sh -c 'prisma migrate diff --from-url \"$DATABASE_URL\" --to-schema-datamodel prisma --script > prisma/diff.sql'",
    "prisma:schema:diff:generate:test": "dotenv -e .env.test -- sh -c 'prisma migrate diff --from-url \"$DATABASE_URL\" --to-schema-datamodel prisma --script > prisma/diff-test.sql'",
    "prisma:schema:print:dev": "prisma db pull --print",
    "prisma:schema:print:test": "dotenv -e .env.test -- prisma db pull --print",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate",
    "start:debug": "run-p start:debug:*",
    "start:debug:admin-api": "nest start admin-api --debug --watch",
    "start:debug:app-api": "nest start app-api --debug --watch",
    "start:debug:firebase-auth-emulators": "make start-firebase-dev-emulators",
    "start:dev": "run-p start:dev:*",
    "start:dev:admin-api": "nest start admin-api --watch",
    "start:dev:app-api": "nest start app-api --watch",
    "start:dev:firebase-auth-emulators": "make start-firebase-dev-emulators",
    "start:prod": "run-p start:prod:*",
    "start:prod:admin-api": "node dist/apis/admin/main",
    "start:prod:app-api": "node dist/apis/app/main",
    "start:test": "run-p start:test:*",
    "start:test:admin-api": "dotenv -e .env.test -- nest start admin-api",
    "start:test:app-api": "dotenv -e .env.test -- nest start app-api",
    "start:test:firebase-auth-emulators": "make start-firebase-test-emulators",
    "test": "jest --config ./tests/jest.config.ts",
    "test:cov": "bun run test --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config ./tests/jest.config.ts --runInBand",
    "test:watch": "bun run test --watch",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "bcrypt": "6.0.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@golevelup/ts-jest": "0.7.0",
    "@music-practice-tracker/eslint-plugins": "workspace:*",
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.6",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.3",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "firebase-admin": "13.5.0",
    "prisma": "6.16.2",
    "supertest": "7.1.4"
  }
}
