{
  "name": "@music-practice-tracker/backend-next",
  "version": "0.0.1",
  "private": true,
  "description": "Effect-native rebuild of backend (replaces @music-practice-tracker/backend when complete). Drizzle + BetterAuth × 2 + @effect/platform-bun.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "auth:generate": "bun x @better-auth/cli@latest generate",
    "build": "bun build src/apps/app-api/main.ts src/apps/admin-api/main.ts --target bun --outdir dist --splitting",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:migrate:test": "dotenv -e .env.test -- drizzle-kit migrate",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio",
    "lint:es:check": "eslint",
    "lint:es:fix": "eslint --fix",
    "start:dev": "run-p --print-label start:dev:*",
    "start:dev:admin-api": "bun run --watch src/apps/admin-api/main.ts",
    "start:dev:app-api": "bun run --watch src/apps/app-api/main.ts",
    "start:prod": "run-p --print-label start:prod:*",
    "start:prod:admin-api": "bun run dist/apps/admin-api/main.js",
    "start:prod:app-api": "bun run dist/apps/app-api/main.js",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/opentelemetry": "^0.63.0",
    "@effect/platform": "^0.96.0",
    "@effect/platform-bun": "^0.89.0",
    "better-auth": "^1.6.0",
    "drizzle-orm": "^0.45.0",
    "effect": "^3.21.0",
    "pg": "^8.13.0",
    "pino": "^10.3.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "4.1.4",
    "drizzle-kit": "^0.31.0",
    "pino-pretty": "^13.1.3",
    "vitest": "4.1.4"
  }
}
