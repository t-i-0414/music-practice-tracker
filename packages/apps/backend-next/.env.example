# --- Required ---
# Postgres connection string. Reuse the existing dev DB (port 15432 + offset).
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/music_practice_tracker

# Random secret for BetterAuth (generate with: bun x @better-auth/cli@latest secret)
BETTER_AUTH_SECRET=change-me-32-bytes-of-random-data

# Public URLs each BetterAuth instance answers under (used in magic-link emails).
APP_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001

# --- Optional (per-feature) ---
# App API listen ports (defaults: 3000 / 3001)
APP_API_PORT=3000
ADMIN_API_PORT=3001

# Social providers (App instance)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Magic Link email provider (stub logs URL when unset)
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# Logging
NODE_ENV=development
LOG_LEVEL=debug
