{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "commitMessagePrefix": "chore: ",
  "rangeStrategy": "bump",
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "Exclude react and react-dom repo-wide",
      "enabled": false,
      "matchPackageNames": [
        "react",
        "react-dom"
      ]
    },
    {
      "description": "Root package.json updates",
      "matchFiles": [
        "package.json"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Root other dependencies (non-major)",
      "semanticCommitScope": "root"
    },
    {
      "description": "Backend package updates",
      "matchFiles": [
        "packages/apps/backend/package.json"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Backend other dependencies (non-major)",
      "semanticCommitScope": "backend"
    },
    {
      "description": "Admin package updates",
      "matchFiles": [
        "packages/apps/admin/package.json"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Admin other dependencies (non-major)",
      "semanticCommitScope": "admin"
    },
    {
      "description": "ESLint configs package updates",
      "matchFiles": [
        "packages/libs/eslint-configs/package.json"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "ESLint configs other dependencies (non-major)",
      "semanticCommitScope": "eslint-configs"
    },
    {
      "description": "ESLint plugins package updates",
      "matchFiles": [
        "packages/libs/eslint-plugins/package.json"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "ESLint plugins other dependencies (non-major)",
      "semanticCommitScope": "eslint-plugins"
    },
    {
      "description": "Majors: 1 PR per library (default behavior)",
      "matchUpdateTypes": [
        "major"
      ]
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "packages/apps/mobile/**"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "postUpdateOptions": [
    "npmDedupe"
  ],
  "lockFileMaintenance": {
    "enabled": true
  }
}
