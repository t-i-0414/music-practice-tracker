{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [":semanticCommits", ":semanticCommitTypeAll(chore)"],
  "semanticCommitScope": "{{#if parentDir}}{{parentDir}}{{else}}root{{/if}}",
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore: ",
  "rangeStrategy": "bump",
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "Exclude react and react-dom repo-wide",
      "enabled": false,
      "matchPackageNames": ["react", "react-dom"]
    },
    {
      "description": "Group patch+minor per package.json (npm)",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major updates ({{packageFileDir}})",
      "additionalBranchPrefix": "{{packageFileDir}}/"
    },
    {
      "description": "Majors: 1 PR per library (default behavior)",
      "matchUpdateTypes": ["major"],
      "separateMultipleMajor": false
    }
  ],
  "ignorePaths": ["**/node_modules/**", "packages/apps/mobile/**"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "postUpdateOptions": ["npmDedupe"],
  "lockFileMaintenance": {
    "enabled": true
  }
}
