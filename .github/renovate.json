{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 5,
  "commitMessagePrefix": "chore: ",
  "rangeStrategy": "replace",
  "rebaseWhen": "never",
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "dependencyDashboard": true,
  "dependencyDashboardAutoclose": true,
  "minimumReleaseAge": "5 days",
  "ignoreDeps": ["anthropics/claude-code-action", "postgres"],
  "ignorePaths": ["**/node_modules/**", "packages/apps/mobile/**"],
  "postUpdateOptions": [],
  "packageRules": [
    {
      "description": "Exclude react and react-dom repo-wide",
      "enabled": false,
      "matchPackageNames": ["react", "react-dom", "react-test-renderer"]
    },
    {
      "description": "Root package.json updates",
      "matchFileNames": ["package.json"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Root other dependencies (non-major)",
      "semanticCommitScope": "root"
    },
    {
      "description": "Backend package updates",
      "matchFileNames": ["packages/apps/backend/package.json"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Backend other dependencies (non-major)",
      "semanticCommitScope": "backend"
    },
    {
      "description": "Admin package updates",
      "matchFileNames": ["packages/apps/admin/package.json"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Admin other dependencies (non-major)",
      "semanticCommitScope": "admin"
    },
    {
      "description": "ESLint configs package updates",
      "matchFileNames": ["packages/libs/eslint-configs/package.json"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "ESLint configs other dependencies (non-major)",
      "semanticCommitScope": "eslint-configs"
    },
    {
      "description": "ESLint plugins package updates",
      "matchFileNames": ["packages/libs/eslint-plugins/package.json"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "ESLint plugins other dependencies (non-major)",
      "semanticCommitScope": "eslint-plugins"
    },
    {
      "description": "Security updates - immediate",
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["patch", "minor"],
      "prPriority": 10,
      "schedule": ["at any time"],
      "vulnerabilityAlerts": {
        "enabled": true,
        "labels": ["security", "urgent"]
      }
    },
    {
      "description": "Major updates - manual review required",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major"],
      "draftPR": true,
      "prPriority": -10
    },
    {
      "description": "Lock file maintenance priority",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "prPriority": -1
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["after 2am on Sunday"]
  },
  "timezone": "Asia/Tokyo",
  "schedule": ["after 2am and before 6pm every weekday"],
  "prCreation": "immediate",
  "suppressNotifications": ["prIgnoreNotification"]
}
