{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:monorepos",
    "group:recommended"
  ],
  "prHourlyLimit": 20,
  "prConcurrentLimit": 20,
  "branchConcurrentLimit": 20,
  "labels": [
    "dependencies"
  ],
  "commitMessagePrefix": "chore: ",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{#if isPinDigest}}{{{newDigestShort}}}{{else}}{{#if isMajor}}{{prettyNewMajor}}{{else}}{{#if isSingleVersion}}{{prettyNewVersion}}{{else}}{{#if newValue}}{{{newValue}}}{{else}}{{{newDigestShort}}}{{/if}}{{/if}}{{/if}}{{/if}}",
  "rangeStrategy": "bump",
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Dashboard",
  "packageRules": [
    {
      "description": "==== Priority 1: Disabled packages (highest priority) ====",
      "matchPackageNames": [
        "@prisma/client",
        "react",
        "react-dom",
        "react-test-renderer",
        "anthropics/claude-code-action"
      ],
      "enabled": false
    },
    {
      "description": "==== Priority 2: Security updates ====",
      "matchUpdateTypes": [
        "patch"
      ],
      "matchCategories": [
        "security"
      ],
      "prPriority": 10,
      "addLabels": [
        "security"
      ],
      "automerge": true,
      "groupName": "Security updates",
    },
    {
      "description": "==== Priority 3: GitHub Actions ====",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true,
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "addLabels": [
        "github-actions"
      ],
      "commitMessagePrefix": "ci: ",
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Group NestJS packages (backend only)",
      "matchFileNames": [
        "packages/apps/backend/package.json"
      ],
      "matchPackagePatterns": [
        "@nestjs/*",
        "nest-*"
      ],
      "groupName": "NestJS packages",
      "groupSlug": "nestjs",
      "addLabels": [
        "backend",
        "nestjs"
      ],
      "commitMessagePrefix": "chore(backend): "
    },
    {
      "description": "Group Next.js packages (admin only)",
      "matchFileNames": [
        "packages/apps/admin/package.json"
      ],
      "matchPackageNames": [
        "next",
        "eslint-config-next"
      ],
      "matchPackagePatterns": [
        "@next/*"
      ],
      "groupName": "Next.js packages",
      "groupSlug": "nextjs",
      "addLabels": [
        "admin",
        "nextjs"
      ],
      "commitMessagePrefix": "chore(admin): "
    },
    {
      "description": "Group Storybook packages",
      "matchPackagePatterns": [
        "@storybook/*",
        "@chromatic-com/storybook"
      ],
      "groupName": "Storybook packages",
      "groupSlug": "storybook",
      "addLabels": [
        "storybook"
      ]
    },
    {
      "description": "Group ESLint packages",
      "matchPackageNames": [
        "eslint",
        "eslint-config-next"
      ],
      "matchPackagePatterns": [
        "eslint-*",
        "@eslint/*",
        "@typescript-eslint/*",
        "@vitest/eslint-plugin"
      ],
      "excludePackageNames": [
        "eslint-config-next"
      ],
      "groupName": "ESLint packages",
      "groupSlug": "eslint",
      "addLabels": [
        "linting"
      ]
    },
    {
      "description": "Group Jest packages",
      "matchPackageNames": [
        "jest",
        "ts-jest",
        "babel-jest"
      ],
      "matchPackagePatterns": [
        "@jest/*",
        "@types/jest"
      ],
      "groupName": "Jest packages",
      "groupSlug": "jest",
      "addLabels": [
        "testing"
      ]
    },
    {
      "description": "Group Testing Library packages",
      "matchPackagePatterns": [
        "@testing-library/*"
      ],
      "groupName": "Testing Library packages",
      "groupSlug": "testing-library",
      "addLabels": [
        "testing"
      ]
    },
    {
      "description": "Group Playwright packages",
      "matchPackagePatterns": [
        "@playwright/*"
      ],
      "groupName": "Playwright packages",
      "groupSlug": "playwright",
      "addLabels": [
        "testing"
      ]
    },
    {
      "description": "Group MSW packages",
      "matchPackageNames": [
        "msw"
      ],
      "matchPackagePatterns": [
        "msw-*"
      ],
      "groupName": "MSW packages",
      "groupSlug": "msw",
      "addLabels": [
        "testing"
      ]
    },
    {
      "description": "Group TypeScript type definitions",
      "matchPackagePatterns": [
        "@types/*"
      ],
      "groupName": "TypeScript type definitions",
      "groupSlug": "types",
      "addLabels": [
        "types"
      ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Group Prisma packages (excluding client)",
      "matchPackageNames": [
        "prisma"
      ],
      "matchPackagePatterns": [
        "@prisma/*"
      ],
      "excludePackageNames": [
        "@prisma/client"
      ],
      "groupName": "Prisma packages",
      "groupSlug": "prisma",
      "addLabels": [
        "database"
      ]
    },
    {
      "description": "Backend other dependencies (non-major)",
      "matchFileNames": [
        "packages/apps/backend/package.json"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "excludePackagePatterns": [
        "@nestjs/*",
        "nest-*",
        "@types/*",
        "@prisma/*",
        "prisma",
        "eslint*",
        "@eslint/*",
        "@typescript-eslint/*",
        "jest*",
        "@jest/*",
        "@testing-library/*",
        "@playwright/*",
        "msw*"
      ],
      "groupName": "Backend other dependencies (non-major)",
      "groupSlug": "backend-other",
      "addLabels": [
        "backend"
      ],
      "commitMessagePrefix": "chore(backend): "
    },
    {
      "description": "Admin other dependencies (non-major)",
      "matchFileNames": [
        "packages/apps/admin/package.json"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "excludePackageNames": [
        "next",
        "eslint-config-next"
      ],
      "excludePackagePatterns": [
        "@next/*",
        "@types/*",
        "eslint*",
        "@eslint/*",
        "@typescript-eslint/*",
        "@testing-library/*",
        "@storybook/*"
      ],
      "groupName": "Admin other dependencies (non-major)",
      "groupSlug": "admin-other",
      "addLabels": [
        "admin"
      ],
      "commitMessagePrefix": "chore(admin): "
    },
    {
      "description": "Root other dependencies (non-major)",
      "matchFileNames": [
        "package.json"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "excludePackagePatterns": [
        "@storybook/*",
        "@chromatic-com/*",
        "eslint*",
        "@eslint/*",
        "@typescript-eslint/*",
        "jest*",
        "@jest/*",
        "@types/*",
        "@testing-library/*",
        "@playwright/*",
        "prisma",
        "@prisma/*",
        "msw*"
      ],
      "groupName": "Root other dependencies (non-major)",
      "groupSlug": "root-other",
      "addLabels": [
        "root"
      ],
      "commitMessagePrefix": "chore(root): "
    },
    {
      "description": "Automerge patch updates for non-critical packages",
      "matchUpdateTypes": [
        "patch"
      ],
      "excludePackageNames": [
        "react",
        "react-dom"
      ],
      "excludePackagePatterns": [
        "@nestjs/*",
        "next*",
        "@next/*",
        "@prisma/*"
      ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Lock file maintenance",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "automerge": true,
      "automergeType": "branch"
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "packages/apps/mobile/**"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "postUpdateOptions": [
    "npmDedupe"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  }
}
