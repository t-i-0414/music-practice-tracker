#!/bin/bash
# Start Firebase Dev Emulators with ports from environment variables

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Load .env if it exists
if [ -f "$PROJECT_ROOT/.env" ]; then
  # shellcheck disable=SC1091
  source "$PROJECT_ROOT/.env"
fi

# Default ports (if .env doesn't exist)
FIREBASE_AUTH_PORT=${FIREBASE_AUTH_PORT:-9099}
FIREBASE_UI_PORT=${FIREBASE_UI_PORT:-4000}
FIREBASE_HUB_PORT=${FIREBASE_HUB_PORT:-4400}
FIREBASE_LOGGING_PORT=${FIREBASE_LOGGING_PORT:-4500}

echo "Starting Firebase Dev Emulators..."
echo "  Auth:    localhost:$FIREBASE_AUTH_PORT"
echo "  UI:      http://localhost:$FIREBASE_UI_PORT"
echo "  Hub:     localhost:$FIREBASE_HUB_PORT"
echo "  Logging: localhost:$FIREBASE_LOGGING_PORT"
echo ""

# Check if port is already in use
check_port() {
  local port=$1
  local name=$2
  if lsof -Pi :"$port" -sTCP:LISTEN -t >/dev/null 2>&1; then
    echo "Warning: Port $port ($name) is already in use"
    return 1
  fi
  return 0
}

if ! check_port "$FIREBASE_AUTH_PORT" "Auth" || \
   ! check_port "$FIREBASE_UI_PORT" "UI" || \
   ! check_port "$FIREBASE_HUB_PORT" "Hub"; then
  echo ""
  echo "Firebase emulators may already be running."
  echo "To view the emulator UI, open: http://localhost:$FIREBASE_UI_PORT"
  exit 0
fi

# Generate temporary firebase config file
TEMP_CONFIG=$(mktemp)
cat > "$TEMP_CONFIG" << EOF
{
  "emulators": {
    "auth": {
      "port": $FIREBASE_AUTH_PORT
    },
    "ui": {
      "enabled": true,
      "port": $FIREBASE_UI_PORT
    },
    "hub": {
      "port": $FIREBASE_HUB_PORT
    },
    "logging": {
      "port": $FIREBASE_LOGGING_PORT
    }
  }
}
EOF

# Remove temp file on exit
cleanup() {
  rm -f "$TEMP_CONFIG"
}
trap cleanup EXIT

# Start Firebase Emulators
cd "$PROJECT_ROOT"
firebase emulators:start \
  --config "$TEMP_CONFIG" \
  --project music-practice-tracker-dev \
  --import ./.firebase-emulator-data/dev \
  --export-on-exit
