#!/bin/bash
# List all git worktrees with Docker status

set -e

echo "=== Git Worktrees and Docker Status ==="
echo ""
git worktree list 2>/dev/null | while read -r line; do
  WORKTREE_PATH=$(echo "$line" | awk '{print $1}')
  BRANCH=$(echo "$line" | awk '{print $3}' | tr -d '[]')
  WORKTREE_NAME=$(basename "$WORKTREE_PATH")
  PROJECT_NAME=$(echo "$WORKTREE_NAME" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g')

  # Check if containers for this project are running
  RUNNING=$(docker ps --filter "name=${PROJECT_NAME}" --format "{{.Status}}" 2>/dev/null | head -1)
  if [ -n "$RUNNING" ]; then
    STATUS="Running"
    # Get port
    DB_PORT=$(docker ps --filter "name=${PROJECT_NAME}-db" --format "{{.Ports}}" 2>/dev/null | grep -oE '0\.0\.0\.0:[0-9]+->5432' | head -1 | cut -d: -f2 | cut -d- -f1)
    if [ -n "$DB_PORT" ]; then
      STATUS="Running (DB: localhost:$DB_PORT)"
    fi
  else
    STATUS="Stopped"
  fi

  echo "  $WORKTREE_NAME ($BRANCH)"
  echo "    Path:   $WORKTREE_PATH"
  echo "    Status: $STATUS"
  echo ""
done
