#!/bin/bash
# Generate .env file for local environment
# Git worktree support: auto-assigns unique ports to each worktree

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# shellcheck source=/dev/null
source "$SCRIPT_DIR/../port-registry"

# Confirm if .env already exists (skip in CI or with --force flag)
if [ -f "$PROJECT_ROOT/.env" ]; then
  if [ -z "$CI" ] && [ "$1" != "--force" ]; then
    echo "Warning: .env already exists. Overwriting will lose custom settings."
    read -p "Continue? [y/N] " -r
    echo
    [[ ! $REPLY =~ ^[Yy]$ ]] && exit 0
  fi
fi

# Get next available offset and register it
NEXT_OFFSET=$(get_next_offset)
register_offset "$NEXT_OFFSET" "$PROJECT_ROOT"

# Generate project name (for Docker Compose)
PROJECT_NAME=$(basename "$PROJECT_ROOT" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g')

# Port calculation
# PostgreSQL
POSTGRES_PORT=$((15432 + NEXT_OFFSET))
POSTGRES_TEST_PORT=$((15433 + NEXT_OFFSET))

# Backend APIs
APP_API_PORT=$((3000 + NEXT_OFFSET))
ADMIN_API_PORT=$((3001 + NEXT_OFFSET))

# Frontend
ADMIN_PORT=$((8000 + NEXT_OFFSET))
ADMIN_STORYBOOK_PORT=$((6006 + NEXT_OFFSET))

# Mobile
APP_PORT_IOS=$((8081 + NEXT_OFFSET))
APP_PORT_ANDROID=$((8082 + NEXT_OFFSET))
APP_PORT_WEB=$((8083 + NEXT_OFFSET))
APP_STORYBOOK_PORT=$((6007 + NEXT_OFFSET))
APP_STORYBOOK_WEB_PORT=$((6008 + NEXT_OFFSET))

# Firebase Emulators
FIREBASE_AUTH_PORT=$((9099 + NEXT_OFFSET))
FIREBASE_UI_PORT=$((4000 + NEXT_OFFSET))
FIREBASE_HUB_PORT=$((4400 + NEXT_OFFSET))
FIREBASE_LOGGING_PORT=$((4500 + NEXT_OFFSET))

# Firebase Test Emulators (uses different base ports)
FIREBASE_TEST_AUTH_PORT=$((9199 + NEXT_OFFSET))
FIREBASE_TEST_UI_PORT=$((4001 + NEXT_OFFSET))
FIREBASE_TEST_HUB_PORT=$((4401 + NEXT_OFFSET))
FIREBASE_TEST_LOGGING_PORT=$((4501 + NEXT_OFFSET))

# Generate .env
cat > "$PROJECT_ROOT/.env" << EOF
# Generated by bin/local/setup-env
# Git Worktree environment configuration
# Port Offset: $NEXT_OFFSET

# Project settings
COMPOSE_PROJECT_NAME=$PROJECT_NAME
PORT_OFFSET=$NEXT_OFFSET

# PostgreSQL (Dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:$POSTGRES_PORT/music_practice_tracker?schema=public
POSTGRES_DB=music_practice_tracker
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=$POSTGRES_PORT
POSTGRES_USER=postgres

# PostgreSQL (Test)
POSTGRES_TEST_PORT=$POSTGRES_TEST_PORT

HOST=localhost

# Backend APIs
ADMIN_API_PORT=$ADMIN_API_PORT
APP_API_PORT=$APP_API_PORT

# Admin Frontend
ADMIN_PORT=$ADMIN_PORT
ADMIN_STORYBOOK_PORT=$ADMIN_STORYBOOK_PORT

# Mobile
APP_PORT_ANDROID=$APP_PORT_ANDROID
APP_PORT_IOS=$APP_PORT_IOS
APP_PORT_WEB=$APP_PORT_WEB
APP_STORYBOOK_PORT=$APP_STORYBOOK_PORT
APP_STORYBOOK__WEB_PORT=$APP_STORYBOOK_WEB_PORT

# Firebase Emulators (Dev)
FIREBASE_AUTH_EMULATOR_HOST=localhost:$FIREBASE_AUTH_PORT
FIREBASE_CHECK_REVOKED=true
FIREBASE_PROJECT_ID=music-practice-tracker-dev
FIREBASE_AUTH_PORT=$FIREBASE_AUTH_PORT
FIREBASE_UI_PORT=$FIREBASE_UI_PORT
FIREBASE_HUB_PORT=$FIREBASE_HUB_PORT
FIREBASE_LOGGING_PORT=$FIREBASE_LOGGING_PORT

# Firebase Emulators (Test)
FIREBASE_TEST_AUTH_PORT=$FIREBASE_TEST_AUTH_PORT
FIREBASE_TEST_UI_PORT=$FIREBASE_TEST_UI_PORT
FIREBASE_TEST_HUB_PORT=$FIREBASE_TEST_HUB_PORT
FIREBASE_TEST_LOGGING_PORT=$FIREBASE_TEST_LOGGING_PORT
EOF

# Generate .env.test
cat > "$PROJECT_ROOT/.env.test" << EOF
# Generated by bin/local/setup-env
# Git Worktree environment configuration (Test)
# Port Offset: $NEXT_OFFSET

# PostgreSQL (Test)
DATABASE_URL=postgresql://postgres:postgres@localhost:$POSTGRES_TEST_PORT/music_practice_tracker_test?schema=public
POSTGRES_DB=music_practice_tracker_test
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=$POSTGRES_TEST_PORT
POSTGRES_USER=postgres

HOST=localhost

# Backend APIs
ADMIN_API_PORT=$ADMIN_API_PORT
APP_API_PORT=$APP_API_PORT

# Admin Frontend
ADMIN_PORT=$ADMIN_PORT
ADMIN_STORYBOOK_PORT=$ADMIN_STORYBOOK_PORT

# Mobile
APP_PORT_ANDROID=$APP_PORT_ANDROID
APP_PORT_IOS=$APP_PORT_IOS
APP_PORT_WEB=$APP_PORT_WEB
APP_STORYBOOK_PORT=$APP_STORYBOOK_PORT
APP_STORYBOOK__WEB_PORT=$APP_STORYBOOK_WEB_PORT

# Firebase Emulators (Test)
FIREBASE_AUTH_EMULATOR_HOST=localhost:$FIREBASE_TEST_AUTH_PORT
FIREBASE_CHECK_REVOKED=false
FIREBASE_PROJECT_ID=music-practice-tracker-test
FIREBASE_AUTH_PORT=$FIREBASE_TEST_AUTH_PORT
FIREBASE_UI_PORT=$FIREBASE_TEST_UI_PORT
FIREBASE_HUB_PORT=$FIREBASE_TEST_HUB_PORT
FIREBASE_LOGGING_PORT=$FIREBASE_TEST_LOGGING_PORT
EOF

echo ""
echo "=== Environment Configured ==="
echo ""
echo "Project Name: $PROJECT_NAME"
echo "Port Offset:  $NEXT_OFFSET"
echo ""
echo "PostgreSQL:"
echo "  Dev:  localhost:$POSTGRES_PORT"
echo "  Test: localhost:$POSTGRES_TEST_PORT"
echo ""
echo "Backend APIs:"
echo "  App API:   http://localhost:$APP_API_PORT"
echo "  Admin API: http://localhost:$ADMIN_API_PORT"
echo ""
echo "Frontend:"
echo "  Admin:     http://localhost:$ADMIN_PORT"
echo "  Mobile:    http://localhost:$APP_PORT_IOS (iOS)"
echo ""
echo "Firebase Emulators (Dev):"
echo "  Auth: localhost:$FIREBASE_AUTH_PORT"
echo "  UI:   http://localhost:$FIREBASE_UI_PORT"
echo ""
echo "Generated: .env, .env.test"
echo ""
