{
  "name": "music-practice-tracker",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/t-i-0414/music-practice-tracker.git"
  },
  "license": "UNLICENSED",
  "author": "Takuya Iwashiro <takuya.iwashiro@takudev.net>",
  "workspaces": [
    "packages/apps/*",
    "packages/libs/*"
  ],
  "scripts": {
    "build": "bun turbo build",
    "changeset:add": "changeset",
    "changeset:version": "changeset version",
    "cspell": "cspell '**'",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write . && bun run format:prisma",
    "format:prisma": "cd packages/apps/backend && bun run prisma:format && cd -",
    "lint:dotenv:check": "./bin/dotenv-linter",
    "lint:dotenv:compare": "./bin/dotenv-linter compare .env .env.*",
    "lint:dotenv:fix": "./bin/dotenv-linter fix",
    "lint:es:check": "bun turbo lint:es:check",
    "lint:es:check:root": "eslint",
    "lint:es:fix": "bun turbo lint:es:fix && eslint --fix",
    "lint:markdown:check": "markdownlint '**/*.md' --ignore '**/node_modules/**'",
    "lint:markdown:fix": "markdownlint '**/*.md' --ignore '**/node_modules/**' --fix",
    "lint:secret:check": "secretlint '**/*'",
    "lint:secret:fix": "secretlint --fix '**/*'",
    "lint:shell:check": "sh scripts/lint-shell.sh",
    "test": "bun turbo test",
    "test:cov": "bun turbo test:cov",
    "type:check": "bun turbo type:check",
    "type:check:root": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.0",
    "@changesets/cli": "2.30.0",
    "@chromatic-com/storybook": "5.0.1",
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.4",
    "@faker-js/faker": "10.3.0",
    "@music-practice-tracker/eslint-configs": "workspace:*",
    "@music-practice-tracker/tsconfig-base": "workspace:*",
    "@playwright/test": "1.58.2",
    "@secretlint/secretlint-rule-preset-recommend": "11.3.1",
    "@storybook/addon-a11y": "10.2.19",
    "@storybook/addon-docs": "10.2.19",
    "@storybook/addon-onboarding": "10.2.19",
    "@storybook/addon-vitest": "10.2.19",
    "@storybook/nextjs-vite": "10.2.19",
    "@swc/cli": "0.8.0",
    "@swc/core": "1.15.18",
    "@testing-library/cypress": "10.1.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/babel__preset-env": "7.10.0",
    "@types/bun": "1.3.10",
    "@types/eslint": "9.6.1",
    "@types/estree": "1.0.8",
    "@types/jest": "30.0.0",
    "@types/jsdom": "28.0.0",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-test-renderer": "19.1.0",
    "@types/supertest": "7.2.0",
    "@typescript-eslint/rule-tester": "8.57.0",
    "@typescript-eslint/types": "8.57.0",
    "@typescript-eslint/utils": "8.57.0",
    "@vitest/browser": "4.1.0",
    "@vitest/browser-playwright": "4.1.0",
    "@vitest/coverage-v8": "4.1.0",
    "@vitest/eslint-plugin": "1.6.12",
    "@vitest/ui": "4.1.0",
    "babel-jest": "30.3.0",
    "babel-plugin-module-resolver": "5.0.2",
    "babel-plugin-react-docgen-typescript": "1.5.1",
    "cross-env": "10.1.0",
    "cspell": "9.7.0",
    "cypress": "15.12.0",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.4",
    "eslint-config-expo": "55.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-cypress": "6.2.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.15.0",
    "eslint-plugin-playwright": "2.10.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-storybook": "10.2.19",
