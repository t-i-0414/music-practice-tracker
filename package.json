    "globals": "17.4.0",
    "jest": "30.3.0",
    "jest-mock-extended": "4.0.0",
    "jsdom": "28.1.0",
    "lefthook": "2.1.4",
    "markdownlint-cli": "0.48.0",
    "msw": "2.12.11",
    "npm-run-all2": "8.0.4",
    "openapi-typescript": "7.13.0",
    "playwright": "1.58.2",
    "prettier": "3.8.1",
    "react-test-renderer": "19.1.0",
    "secretlint": "11.3.1",
    "storybook": "10.2.19",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "turbo": "2.8.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "8.0.0",
    "vitest": "4.1.0"
  },
  "packageManager": "bun@1.3.8"
}
