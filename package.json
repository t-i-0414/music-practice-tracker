{
  "name": "music-practice-tracker",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/t-i-0414/music-practice-tracker.git"
  },
  "license": "UNLICENSED",
  "author": "Takuya Iwashiro <takuya.iwashiro@takudev.net>",
  "workspaces": [
    "packages/apps/*",
    "packages/libs/*"
  ],
  "scripts": {
    "changeset:add": "changeset",
    "changeset:version": "changeset version",
    "ci:temp": "bun run format:fix && bun run cspell && bun run lint:es:check && bun run type:check",
    "cspell": "cspell '**'",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write . && bun run format:prisma",
    "format:prisma": "cd packages/apps/backend && bun run prisma:format && cd -",
    "lint:dotenv:check": "./bin/dotenv-linter",
    "lint:dotenv:compare": "./bin/dotenv-linter compare .env .env.*",
    "lint:dotenv:fix": "./bin/dotenv-linter fix",
    "lint:es:check": "eslint && sh scripts/lint-es.sh",
    "lint:es:fix": "eslint --fix && sh scripts/lint-es.sh --fix",
    "lint:markdown:check": "markdownlint '**/*.md' --ignore '**/node_modules/**'",
    "lint:markdown:fix": "markdownlint '**/*.md' --ignore '**/node_modules/**' --fix",
    "lint:secret:check": "secretlint '**/*'",
    "lint:secret:fix": "secretlint --fix '**/*'",
    "lint:shell:check": "sh scripts/lint-shell.sh",
    "quality:check": "bun run format:check && bun run cspell && bun run lint:es:check && bun run type:check",
    "quality:fix": "bun run format:fix && bun run cspell && bun run lint:es:fix && bun run type:check",
    "type:check": "tsc --noEmit && sh scripts/type_check.sh"
  },
  "dependencies": {
    "dotenv": "17.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@babel/preset-env": "7.28.6",
    "@changesets/cli": "2.29.8",
    "@chromatic-com/storybook": "5.0.0",
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-conventional": "20.3.1",
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@faker-js/faker": "10.2.0",
    "@music-practice-tracker/eslint-configs": "workspace:*",
    "@music-practice-tracker/tsconfig-base": "workspace:*",
    "@playwright/test": "1.58.0",
    "@secretlint/secretlint-rule-preset-recommend": "11.3.1",
    "@storybook/addon-a11y": "10.2.1",
    "@storybook/addon-docs": "10.2.1",
    "@storybook/addon-onboarding": "10.2.1",
    "@storybook/addon-vitest": "10.2.1",
    "@storybook/nextjs-vite": "10.2.1",
    "@swc/cli": "0.7.10",
    "@swc/core": "1.15.11",
    "@testing-library/cypress": "10.1.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/babel__preset-env": "7.10.0",
    "@types/bun": "1.3.8",
    "@types/eslint": "9.6.1",
    "@types/estree": "1.0.8",
    "@types/jest": "30.0.0",
    "@types/jsdom": "27.0.0",
    "@types/node": "25.1.0",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@types/react-test-renderer": "19.1.0",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/rule-tester": "8.54.0",
    "@typescript-eslint/types": "8.54.0",
    "@typescript-eslint/utils": "8.54.0",
    "@vitest/browser": "4.0.18",
    "@vitest/browser-playwright": "4.0.18",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/eslint-plugin": "1.6.6",
    "@vitest/ui": "4.0.18",
    "babel-jest": "30.2.0",
    "babel-plugin-module-resolver": "5.0.2",
    "babel-plugin-react-docgen-typescript": "1.5.1",
    "cross-env": "10.1.0",
    "cspell": "9.6.2",
    "cypress": "15.9.0",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.2",
    "eslint-config-expo": "10.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-cypress": "5.2.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.12.1",
    "eslint-plugin-playwright": "2.5.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-storybook": "10.2.1",
    "eslint-plugin-testing-library": "7.15.4",
    "eslint-plugin-unused-imports": "4.3.0",
    "firebase-tools": "15.5.1",
    "globals": "17.2.0",
    "jest": "30.2.0",
    "jest-mock-extended": "4.0.0",
    "jsdom": "27.4.0",
    "lefthook": "2.0.16",
    "markdownlint-cli": "0.47.0",
    "msw": "2.12.7",
    "npm-run-all2": "8.0.4",
    "openapi-typescript": "7.10.1",
    "playwright": "1.58.0",
    "prettier": "3.8.1",
    "react-test-renderer": "19.1.0",
    "secretlint": "11.3.1",
    "storybook": "10.2.1",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
